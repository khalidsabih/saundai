# syntax=docker/dockerfile:1.7
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/djai
COPY pyproject.toml constraints.txt README.md LICENSE VERSION ./
COPY src ./src
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -c constraints.txt '.[stems]'
WORKDIR /workspace
ENV PYTHONPATH=/workspace/src
ENTRYPOINT ["python", "-m", "djai"]
