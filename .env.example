# Copy to .env and change secrets before sharing the service beyond localhost.
# Frontend -> API route used by the Next.js server. Browsers stay same-origin at /api.
SAUND_INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_SAUND_API_URL=http://localhost:8000
DJAI_CONFIRMATION_SECRET=local-development-secret-change-me
DJAI_JOB_WORKERS=2
DJAI_STEM_JOB_WORKERS=1
DJAI_CPU_BUDGET=0
DJAI_JOB_HEARTBEAT_SECONDS=5
DJAI_JOB_STALL_SECONDS=180
DJAI_ANALYSIS_WORKERS=0
DJAI_GRAPH_WORKERS=0
DJAI_PROCESS_START_METHOD=auto
DJAI_PLANNER_MODE=move_authoritative
DJAI_CRATE_MEMORY=1
DJAI_CRATE_MEMORY_PATH=ratings/crate-memory.sqlite3
DJAI_CRATE_MEMORY_MAX_ADJUSTMENT=0.065
SAUND_REQUIRE_RELEASE_BENCHMARK=1
SAUND_RELEASE_BENCHMARK_SUITE=standard
# Large-crate planning. Ordering scouts a bounded cue subset, then final selected
# transitions restore the full cue pool and rendered quality gate.
DJAI_LARGE_SET_THRESHOLD=8
DJAI_GRAPH_SCOUT_CUES=5
DJAI_LARGE_SET_POLICY_STARTS=4
DJAI_LARGE_SET_LOCAL_PASSES=2
# Leave DJAI_MAX_SET_REPLANS unset for the bounded 3-8 automatic default.
# DJAI_MAX_SET_REPLANS=8

# Foundation track representation listens to distributed windows instead of the
# entire file; local transition-section embeddings remain independent.
DJAI_TRACK_EMBED_WINDOWS=3
DJAI_TRACK_EMBED_WINDOW_SECONDS=24
DJAI_MAX_UPLOAD_BYTES=536870912
DJAI_CORS_ORIGINS=http://localhost:3000
DJAI_API_PORT=8000
DJAI_FRONTEND_PORT=3000

# Account foundation. Browser sessions are opaque server-side sessions stored in SQLite.
# Keep the database inside DJAI_WORKSPACE. Set SAUND_AUTH_COOKIE_SECURE=1 behind HTTPS.
SAUND_ACCOUNT_DB=accounts/accounts.sqlite3
SAUND_AUTH_COOKIE_NAME=saund_session
SAUND_AUTH_SESSION_DAYS=14
SAUND_AUTH_COOKIE_SECURE=0

# Hosted/private-beta deployment (SAUND.AI 1.5). Local mode ignores these.
# Set SAUND_HOSTED_MODE=1 only when DJAI_WORKSPACE is backed by durable storage.
SAUND_ENV=development
SAUND_HOSTED_MODE=0
SAUND_PERSISTENT_WORKSPACE=0
SAUND_PUBLIC_ORIGIN=
SAUND_API_ORIGIN=
SAUND_ALLOWED_HOSTS=
SAUND_UPLOAD_AUTH_REQUIRED=0
SAUND_TRUST_PROXY_HEADERS=0
SAUND_SIGNUP_MODE=open
SAUND_INVITE_CODES=
SAUND_AUTH_RATE_LIMIT_PER_MINUTE=30

# Managed PostgreSQL replaces SAUND_ACCOUNT_DB in hosted mode.
# SAUND_DATABASE_URL=postgresql://user:password@host:5432/saund?sslmode=require
SAUND_HOSTED_REQUIRE_POSTGRES=0

# S3-compatible private object storage (Cloudflare R2 / AWS S3).
SAUND_OBJECT_STORE=off
SAUND_OBJECT_STORE_BUCKET=
SAUND_OBJECT_STORE_ENDPOINT=
SAUND_OBJECT_STORE_REGION=auto
SAUND_OBJECT_STORE_ACCESS_KEY_ID=
SAUND_OBJECT_STORE_SECRET_ACCESS_KEY=
SAUND_OBJECT_STORE_PRESIGN_SECONDS=900
SAUND_OBJECT_STORE_PREFIX=saund
SAUND_OBJECT_STORE_DELETE_AFTER_MATERIALIZE=0
SAUND_HOSTED_REQUIRE_OBJECT_STORE=0
# Hosted object-store deployments reject proxy/multipart uploads by default.
SAUND_ALLOW_PROXY_UPLOADS=0
SAUND_ALLOW_HOSTED_TRAINING_LAB=0
DJAI_MEASUREMENT_ENABLED=1
DJAI_MEASUREMENT_TOP_K=4
DJAI_MEASUREMENT_SAMPLE_RATE=44100
DJAI_MEASUREMENT_PRE_ROLL=2
DJAI_MEASUREMENT_POST_ROLL=2
DJAI_MEASUREMENT_ANALYTICAL_WEIGHT=0.55
DJAI_MEASUREMENT_AUDIO_WEIGHT=0.45
DJAI_MEASUREMENT_MINIMUM=0.42
DJAI_MEASUREMENT_LOG=ratings/automatic-measurements.jsonl
DJAI_REHEARSAL_CACHE=1

# Automatic-delivery fallback policy
DJAI_AUTO_TOP_K=4
DJAI_AUTO_EXPANDED_TOP_K=8
DJAI_AUTO_MEASUREMENT_MINIMUM=0.42
DJAI_AUTO_RELAXED_MINIMUM=0.28
DJAI_AUTO_EMERGENCY_SECONDS=1.8
# Automatic Create Set should remain a continuous DJ mix. Hard cuts are opt-in.
DJAI_ALLOW_HARD_CUTS=0
DJAI_AUTO_RESCUE_BARS=auto

# Supplied performance layers (full + instrumental + vocals).
# Leave unset to store metadata under $DJAI_WORKSPACE/.djai-cache.
# DJAI_LAYER_REGISTRY=/absolute/path/to/performance-layers.json

# Background track readiness + automatic performance layers.
# Track intelligence is prepared after upload/library discovery so Create can reuse it.
DJAI_BACKGROUND_TRACK_READINESS=1
# Normal Docker builds include Demucs so one full master is enough.
DJAI_AUTO_STEMS=background
DJAI_STEM_MODEL=htdemucs
DJAI_STEM_DEVICE=cpu
DJAI_API_DOCKER_TARGET=brain
DJAI_ENGINE_DOCKER_TARGET=brain

# Learning, personalization and live streaming
DJAI_FEEDBACK_LOG=ratings/feedback-events.jsonl
DJAI_LISTENER_PROFILES=ratings/listener-profiles.json
DJAI_AUTO_REFIT=1
DJAI_AUTO_REFIT_INTERVAL=20
DJAI_LIVE_BITRATE=192k

# Governed neural brain. Weights are never silently downloaded on startup.
DJAI_MODEL_REGISTRY=config/model-registry.json
DJAI_MODEL_ALLOW_DOWNLOAD=0
DJAI_NEURAL_BEATS=auto
DJAI_BEAT_THIS_MODEL=small0
DJAI_BEAT_THIS_DEVICE=auto
DJAI_NEURAL_BEAT_USE_THRESHOLD=0.70
# One-time model cache: ./scripts/djai.sh models-bootstrap
# Optional MERT cache: ./scripts/djai.sh models-bootstrap --mert

# Representation backends. Foundation encoders are sensory evidence, not DJ taste.
DJAI_EMBEDDINGS_ENABLED=1
# auto = cached local MERT when available, otherwise deterministic statistical embedding
DJAI_EMBEDDING_BACKEND=auto
DJAI_EMBEDDING_MODEL=m-a-p/MERT-v1-95M
# Optional local MusicFM backend. Leave unset unless you installed/configured it yourself.
# DJAI_MUSICFM_HOME=/absolute/path/to/musicfm
# DJAI_MUSICFM_STATS=/absolute/path/to/fma_stats.json
# DJAI_MUSICFM_CHECKPOINT=/absolute/path/to/pretrained_fma.pt
# DJAI_MUSICFM_DEVICE=auto
# Keep downloads disabled by default for local-first/reproducible behavior.
DJAI_EMBEDDING_ALLOW_DOWNLOAD=0
DJAI_TRANSITION_RANKER=1
DJAI_TRANSITION_RANKER_MODEL=config/transition-ranker.json

# Bootstrap learned brain (SAUND.AI 1.1). In local/development mode the
# already-trained cue/duration/sequence priors are bounded advisory signals.
# SAUND_ENV=production automatically forces them back to shadow unless
# SAUND_BOOTSTRAP_PRODUCTION_APPROVED=1 is explicitly set after rights review.
DJAI_BOOTSTRAP_RUNTIME_MODE=advisory
DJAI_BOOTSTRAP_CUE_WEIGHT=0.18
DJAI_BOOTSTRAP_DURATION_WEIGHT=0.34
DJAI_BOOTSTRAP_SEQUENCE_WEIGHT=0.18
DJAI_BOOTSTRAP_EXPORT_RUNTIME_INDEX=1
SAUND_BOOTSTRAP_PRODUCTION_APPROVED=0

# Expert cue-point prior (EDM-CUE / CUE-DETR). Disabled by default.
DJAI_CUE_MODEL_ENABLED=0
DJAI_CUE_MODEL_ID=disco-eth/cue-detr
DJAI_CUE_MODEL_ALLOW_DOWNLOAD=0
DJAI_CUE_MODEL_DEVICE=auto
# When using the Docker API with CUE-DETR enabled, build the optional cue target.
# DJAI_API_DOCKER_TARGET=cue

# Autonomous performance brain: intent -> propose -> compile -> rehearse -> critics -> retry/commit
DJAI_PROFESSIONAL_BRAIN=1
DJAI_BRAIN_ANALYTICAL_POOL=48
DJAI_BRAIN_FINALISTS=8
DJAI_BRAIN_RETRY_ROUNDS=2
DJAI_BRAIN_DIVERSITY_WEIGHT=0.34
DJAI_BRAIN_MINIMUM_SCORE=0.56
DJAI_UNIFIED_MINIMUM_SCORE=0.56
DJAI_BRAIN_REHEARSAL_MINIMUM=0.34
# Phrase-role-aware set mixing window. These are soft targets, not hard cuts.
DJAI_TARGET_SOURCE_PLAY_SECONDS=150
DJAI_SOFT_MAX_SOURCE_PLAY_SECONDS=210
DJAI_REJECTION_MEMORY=ratings/rejected-transitions.jsonl
DJAI_RENDER_EMBEDDING_BACKEND=statistical

# Receding-horizon set brain
DJAI_SET_LOOKAHEAD_DEPTH=3
DJAI_SET_LOOKAHEAD_BEAM=5
DJAI_SET_FUTURE_DISCOUNT=0.78
DJAI_SET_CONTEXT_WEIGHT=0.32

# Release-only legal gate. Leave 0 for normal development. Set/export 1 only if you hold distribution rights to the supplied hero intro.
SAUND_HERO_INTRO_RIGHTS_CONFIRMED=0

# Internal SAUND.AI Training Lab. Keep disabled on public deployments.
DJAI_TRAINING_LAB_ENABLED=1
# Set to 1 only when the audio used for training is cleared for the intended model training use.
SAUND_TRAINING_SOURCE_RIGHTS_CONFIRMED=0
# SAUND.AI 1.1.1 Taste Learning Loop. Candidate evidence is structured,
# audio-free and path-pseudonymized. Disable only if you do not want local
# rehearsal evidence retained for later taste training.
DJAI_TASTE_EVIDENCE_CAPTURE=1
# Build measured synthetic technical failures from local blind-session audio
# during snapshot creation. Corrupted WAVs stay in memory and are not saved.
DJAI_TASTE_SYNTHETIC_FAILURES=1
DJAI_TASTE_SYNTHETIC_MAX_CANDIDATES=128

# SAUND.AI 1.2 — DJ deck performance. The incoming deck beatmatches for the
# handoff, can receive a small beat-phase nudge, then takes tempo ownership and
# glides back to native BPM with pitch-preserving time stretch.
DJAI_DECK_PHASE_NUDGE=1
DJAI_DECK_PHASE_NUDGE_MAX_MS=90
DJAI_DECK_TEMPO_RELEASE=1
DJAI_DECK_TEMPO_RELEASE_MAX=0.10

# SAUND.AI 1.4 — Human DJ Move Brain. Planning is bar/phrase-native: track
# choice, exit, entry, duration, tempo/deck execution and the resulting state
# are evaluated as one complete DJ move. Wall-clock coverage is only a weak
# pacing prior; hard audio safety remains deterministic.
DJAI_MOVE_BRAIN=1
DJAI_MOVE_ORDER_WEIGHT=0.30
DJAI_MOVE_PLAN_WEIGHT=0.36
DJAI_MOVE_PAYOFF_PROTECTION=0.86
DJAI_MOVE_PROTECTED_IMPORTANCE=0.74
DJAI_MOVE_WAIT_THRESHOLD_BARS=4
DJAI_MOVE_CLOCK_WEIGHT=0.05
DJAI_MOVE_MIN_BODY_BARS=8
DJAI_MOVE_SOFT_TARGET_BARS=48
DJAI_MOVE_SOFT_LATEST_BARS=80

# SAUND.AI 1.7.1 — Complete DJMove crate search.
# 2.0 RC promotes the complete-move planner to the default Docker authority.
# Set move_shadow explicitly when you want side-by-side legacy comparison.
DJAI_PLANNER_MODE=move_authoritative
DJAI_LAZY_CANDIDATE_WIDTH=10
DJAI_LAZY_EXPANSION_WIDTH=10
DJAI_LAZY_OPENER_CANDIDATES=5
DJAI_MOVE_LOOKAHEAD=3
DJAI_MOVE_SEARCH_BRANCH_WIDTH=3
DJAI_MOVE_LOOKAHEAD_DISCOUNT=0.72

# SAUND.AI 1.8.0 — AI Headphones private real-audio move rehearsal.
# Active only when the complete-move planner is authoritative. Future search
# stays analytical; only the current commit boundary spends the render budget.
DJAI_HEADPHONES=1
DJAI_HEADPHONES_SERIOUS_POOL=12
DJAI_HEADPHONES_MIN_RENDERS=2
DJAI_HEADPHONES_MAX_RENDERS=4
DJAI_HEADPHONES_AMBIGUOUS_MARGIN=0.045
DJAI_HEADPHONES_MODERATE_MARGIN=0.090
DJAI_HEADPHONES_UNCERTAINTY_EXPAND=0.28
DJAI_HEADPHONES_RENDERED_MARGIN_EXPAND=0.035
DJAI_HEADPHONES_RENDERED_WEIGHT=0.72
DJAI_HEADPHONES_STRUCTURAL_WEIGHT=0.28
DJAI_HEADPHONES_SAMPLE_RATE=22050
DJAI_HEADPHONES_CONTEXT_SECONDS=2
DJAI_HEADPHONES_MEASUREMENT_MINIMUM=0.34
DJAI_HEADPHONES_JUDGE_MINIMUM=0.56
DJAI_HEADPHONES_MEASUREMENT_LOG=ratings/headphones-measurements.jsonl

# SAUND.AI 1.7.2 — deterministic structural deck operations.
# WAIT is compiled automatically. More invasive deck operations are opt-in
# until they have enough benchmark/listening evidence to become default policy.
DJAI_STRUCTURAL_DECK_OPS=1
DJAI_STRUCTURAL_LOOP_OUTGOING=0
DJAI_STRUCTURAL_EXTEND_INTRO=0
DJAI_STRUCTURAL_HOLD_STEM=0
DJAI_STRUCTURAL_JUMPS=0
DJAI_STRUCTURAL_MIN_LOOP_WAIT_BARS=20

# SAUND.AI 1.8.2 — persistent record/pair Crate Memory.
# Memory is a bounded prior only; AI Headphones and deterministic safety retain veto authority.
DJAI_CRATE_MEMORY=1
DJAI_CRATE_MEMORY_PATH=ratings/crate-memory.sqlite3
DJAI_CRATE_MEMORY_MAX_ADJUSTMENT=0.065

# 1.9/2.0 release benchmark gate. RC certification requires this evidence even
# when the local development flag remains off.
SAUND_REQUIRE_RELEASE_BENCHMARK=0
SAUND_RELEASE_BENCHMARK_SUITE=standard
