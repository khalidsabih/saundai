# SAUND.AI 1.5 hosted/private-beta profile.
SAUND_PUBLIC_ORIGIN=https://app.example.com
SAUND_API_ORIGIN=https://api.example.com
SAUND_ALLOWED_HOSTS=api.example.com,app.example.com
DJAI_CORS_ORIGINS=https://app.example.com
NEXT_PUBLIC_SAUND_API_URL=https://api.example.com

# Durable managed PostgreSQL. Prefer a provider connection string with TLS enabled.
SAUND_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# S3-compatible object storage (Cloudflare R2 shown).
SAUND_OBJECT_STORE=s3
SAUND_OBJECT_STORE_BUCKET=saund-private-beta
SAUND_OBJECT_STORE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
SAUND_OBJECT_STORE_REGION=auto
SAUND_OBJECT_STORE_ACCESS_KEY_ID=replace-me
SAUND_OBJECT_STORE_SECRET_ACCESS_KEY=replace-me
SAUND_OBJECT_STORE_PRESIGN_SECONDS=900
SAUND_OBJECT_STORE_PREFIX=saund

# Hosted safety gates.
SAUND_ENV=production
SAUND_HOSTED_MODE=1
SAUND_PERSISTENT_WORKSPACE=1
SAUND_HOSTED_REQUIRE_POSTGRES=1
SAUND_HOSTED_REQUIRE_OBJECT_STORE=1
SAUND_AUTH_COOKIE_SECURE=1
SAUND_UPLOAD_AUTH_REQUIRED=1
SAUND_TRUST_PROXY_HEADERS=1
DJAI_CONFIRMATION_SECRET=replace-with-at-least-32-random-characters

# Private beta access.
SAUND_SIGNUP_MODE=invite
SAUND_INVITE_CODES=replace-beta-code-1,replace-beta-code-2
SAUND_AUTH_RATE_LIMIT_PER_MINUTE=30

# Keep internal research surfaces off public deployments.
DJAI_TRAINING_LAB_ENABLED=0
SAUND_ALLOW_HOSTED_TRAINING_LAB=0

# Production model policy remains default-deny.
DJAI_MODEL_ALLOW_DOWNLOAD=0
DJAI_EMBEDDING_ALLOW_DOWNLOAD=0
DJAI_BOOTSTRAP_RUNTIME_MODE=shadow
SAUND_BOOTSTRAP_PRODUCTION_APPROVED=0

# Job execution in 1.5 is intentionally one durable backend node.
DJAI_JOB_WORKERS=2
DJAI_STEM_JOB_WORKERS=1
DJAI_AUTO_STEMS=background
DJAI_STEM_DEVICE=cpu
